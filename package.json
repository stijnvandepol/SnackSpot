{
  "name": "snackspot",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm run db:generate && pnpm --filter web build",
    "start": "pnpm --filter web start",
    "db:generate": "pnpm --filter @snackspot/db generate",
    "db:migrate": "pnpm --filter @snackspot/db migrate",
    "db:seed": "pnpm --filter @snackspot/db seed",
    "worker:dev": "pnpm --filter worker dev",
    "validate": "tsx scripts/validate-round-trip.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css}\""
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.4.1",
      "fast-xml-parser": "5.8.0",
      "fast-xml-builder": ">=1.1.7",
      "lodash": ">=4.18.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss@<8.5.18": ">=8.5.18",
      "uuid@>=9.0.0 <11.1.1": ">=11.1.1",
      "brace-expansion": ">=5.0.9",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "sharp@<0.35.0": ">=0.35.0",
      "protocol-buffers-schema@<3.6.1": ">=3.6.1",
      "esbuild@>=0.17.0 <0.28.1": ">=0.28.1",
      "undici@>=7.23.0 <7.29.0": "^7.29.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5xrq-8626-4rwp"
      ]
    }
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6"
  }
}
